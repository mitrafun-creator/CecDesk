{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CecDesk",
  "version": "1.1.0-beta.1",
  "identifier": "com.cecdesk.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CecDesk",
        "width": 1180,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#070709"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
